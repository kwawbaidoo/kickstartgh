# Copy this file to .env.local and adjust as needed. .env.local is gitignored —
# never commit real secrets or environment-specific URLs directly to this file.

# Base URL for the KickStartGH REST API (see postman_collection.json / BACKEND_INTEGRATION_TRACKER.md).
# Confirmed live and reachable as of 2026-08-15, with CORS already allowing http://localhost:3000.
NEXT_PUBLIC_API_BASE_URL=https://api.kickstartgh.com/api

# Where "Request access" submissions are sent. The landing page has no self-serve sign-up —
# accounts are provisioned — so this form hands the request to the visitor's own WhatsApp or
# mail client. Leave either blank to hide that option; with both blank the form falls back to
# a copy-to-clipboard summary. See BACKEND_GAPS.md §7.4 for the endpoint that would replace this.
NEXT_PUBLIC_SUPPORT_WHATSAPP=233200000000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@kickstartgh.com
